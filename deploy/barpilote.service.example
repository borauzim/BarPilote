[Unit]
Description=BarPilote Daphne ASGI
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=deploy
Group=www-data
WorkingDirectory=/var/www/barpilote
EnvironmentFile=/var/www/barpilote/.env
ExecStart=/var/www/barpilote/.venv/bin/daphne -b 127.0.0.1 -p 8000 barpilote.asgi:application
Restart=always
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
