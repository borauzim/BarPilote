DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=barpilote.com,www.barpilote.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://barpilote.com,https://www.barpilote.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
SITE_URL=https://www.barpilote.com
REDIS_URL=redis://127.0.0.1:6379/0
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BarPilote <noreply@barpilote.example.com>
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FCM_SERVICE_ACCOUNT_FILE=/var/www/barpilote/secrets/firebase-service-account.json
FCM_WEB_API_KEY=
FCM_WEB_AUTH_DOMAIN=
FCM_WEB_PROJECT_ID=
FCM_WEB_STORAGE_BUCKET=
FCM_WEB_MESSAGING_SENDER_ID=
FCM_WEB_APP_ID=
FCM_WEB_VAPID_KEY=
